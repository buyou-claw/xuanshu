{
  "name": "xuanshu",
  "version": "0.1.0",
  "private": true,
  "description": "玄枢 — 站在 DSH 上做「装配 + 定制」的个人玄学中枢（profile + 插件 + skills + setup）",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm --filter ./packages/xuanshu-client run build",
    "build:client": "pnpm --filter ./packages/xuanshu-client run build",
    "install:profile": "node scripts/install-profile.mjs",
    "setup:xuanshu": "node scripts/setup.mjs",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "dev:xuanshu": "node scripts/isolation/startup.mjs --mode web",
    "doctor:xuanshu": "node scripts/isolation/startup.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "test": "vitest run",
    "test:inventory": "node scripts/check-test-inventory.mjs",
    "test:assembly": "vitest run tests/assembly",
    "test:isolation": "vitest run tests/isolation",
    "test:setup": "vitest run tests/setup",
    "test:watch": "vitest",
    "cleanup:worktrees": "node scripts/cleanup-worktrees.mjs",
    "verify:all": "node ./node_modules/typescript/bin/tsc --noEmit -p packages/xuanshu-client/tsconfig.json && node scripts/build-client.mjs --check && node scripts/check-test-inventory.mjs && node scripts/check-doc-numbers.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-native-command": "0.2.0-rc.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  }
}
