{
  "name": "xuanshu",
  "version": "0.1.0",
  "private": true,
  "description": "玄枢 — 站在 DSH 上做「装配 + 定制」的个人玄学中枢（profile + 插件 + skills + setup）",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm --filter ./packages/xuanshu-client run build",
    "build:client": "pnpm --filter ./packages/xuanshu-client run build",
    "install:profile": "node scripts/install-profile.mjs",
    "verify:assembly": "node scripts/verify-assembly.mjs",
    "test": "vitest run",
    "test:assembly": "vitest run tests/assembly",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
